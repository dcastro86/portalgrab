[Unit]
Description=portalgrab screen-region capture daemon
Documentation=https://github.com/dcastro86/portalgrab
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/portalgrab daemon --lazy
Restart=on-failure
RestartSec=5
# 2 = the portal dialog was refused, or another daemon is running; restarting cannot help.
RestartPreventExitStatus=2

[Install]
WantedBy=graphical-session.target
